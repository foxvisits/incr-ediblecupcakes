# fal.ai API key for local script usage
FAL_KEY=your_fal_ai_key_here

# Google Analytics 4 (optional override; default in code: G-WTVXE7N7M0)
PUBLIC_GA_MEASUREMENT_ID=G-WTVXE7N7M0

# --- Contact form -----------------------------------------------------------
# Required. Resend API key, used by netlify/functions/contact.mjs to deliver
# messages from /contact. Set it in the Netlify UI, not in a committed file.
RESEND_API_KEY=re_your_resend_key_here

# Optional overrides. The defaults below are what the function uses if unset.
# CONTACT_TO_EMAIL must be an inbox you actually read; CONTACT_FROM_EMAIL must
# be on a domain verified in Resend, otherwise delivery fails.
CONTACT_TO_EMAIL=sarah@incr-ediblecupcakes.com
CONTACT_FROM_EMAIL=Incr-EdibleCupCakes <noreply@incr-ediblecupcakes.com>

# Optional extra anti-spam layer (Cloudflare Turnstile). Leave both unset to
# run without it; the honeypot, form token, timing, rate limit and content
# filters work regardless. Set both together or neither.
# PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key
# TURNSTILE_SECRET_KEY=0x4AAAAAAA_your_secret_key
